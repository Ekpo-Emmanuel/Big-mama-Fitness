# =============================================================================
# Big Mama Fitness — PRODUCTION env REFERENCE (safe to commit)
# =============================================================================
# Canonical origin: https://www.bigmamafit.ca
#
# Copy to a private fill-in file (.env.production is gitignored) or enter values
# in Vercel Production env + Convex prod (npx convex env set --prod …).
#
# Never put real secrets in this file.
# Never copy DEV / aromatic-hornet-650 values into production.
# =============================================================================

# --- App / canonical URL (Vercel) --------------------------------------------
APP_URL=https://www.bigmamafit.ca
BETTER_AUTH_URL=https://www.bigmamafit.ca

# --- Convex production URLs (Vercel NEXT_PUBLIC_*) ---------------------------
# Dashboard → Production deployment dusty-vole-416
NEXT_PUBLIC_CONVEX_URL=https://YOUR_PROD_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_PROD_DEPLOYMENT.convex.site
CONVEX_DEPLOYMENT=prod:dusty-vole-416

# --- Secrets (generate / dashboard; never commit real values) ----------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=YOUR_PRODUCTION_BETTER_AUTH_SECRET_HERE
CRON_SECRET=YOUR_PRODUCTION_INTERNAL_API_SECRET_HERE

# --- Stripe LIVE (Big Mama Fitness) ------------------------------------------
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SECRET_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=re_YOUR_PRODUCTION_KEY_HERE
RESEND_WEBHOOK_SECRET=YOUR_RESEND_WEBHOOK_SIGNING_SECRET_HERE
EMAIL_FROM="Big Mama Fitness <info@bigmamafit.ca>"
EMAIL_REPLY_TO=info@bigmamafit.ca
EMAIL_PRODUCTION=true
ORGANIZER_EMAIL=optional-extra-organizer@example.com

# --- Google ------------------------------------------------------------------
# GTM browser loader + GA4 ID for Measurement Protocol / GTM GA4 tag config.
NEXT_PUBLIC_GTM_ID=GTM-WJSHN9Q5
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EM4T1KRWT3
GA_API_SECRET=
GOOGLE_SITE_VERIFICATION=

# Do NOT set on production:
#   EMAIL_TEST_REDIRECT
#   ALLOW_EMAIL_TEST_REDIRECT

# =============================================================================
# CONVEX PROD CHECKLIST (dusty-vole-416) — set with --prod
# These do NOT come from Vercel .env.production automatically.
# =============================================================================
#
# REQUIRED (convex.config.ts):
#   npx convex env set --prod SITE_URL "https://www.bigmamafit.ca"
#   npx convex env set --prod BETTER_AUTH_SECRET "<same as above>"
#   npx convex env set --prod CRON_SECRET "<same as Vercel CRON_SECRET>"
#
# REQUIRED for mail + holds:
#   npx convex env set --prod EMAIL_FROM "Big Mama Fitness <info@bigmamafit.ca>"
#   npx convex env set --prod EMAIL_REPLY_TO "info@bigmamafit.ca"
#   npx convex env set --prod EMAIL_PRODUCTION true
#   npx convex env set --prod RESEND_API_KEY "re_..."
#   npx convex env set --prod STRIPE_SECRET_KEY "sk_live_..."
#
# OPTIONAL:
#   npx convex env set --prod ORGANIZER_EMAIL "..."
#
# REQUIRED for GA4 purchase (Measurement Protocol):
#   npx convex env set --prod NEXT_PUBLIC_GA_MEASUREMENT_ID "G-..."
#   npx convex env set --prod GA_API_SECRET "..."
# Leave both unset if purchase analytics should stay skipped.
# MUST BE ABSENT on prod:
#   npx convex env remove --prod EMAIL_TEST_REDIRECT
#   npx convex env remove --prod ALLOW_EMAIL_TEST_REDIRECT
#
# Verify: npm run env:prod:check
# Canonical origin must be https://www.bigmamafit.ca (apex redirects to www).
