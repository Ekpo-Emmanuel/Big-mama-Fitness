{
  "name": "afro-dance-nanaimo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev",
    "convex:prod": "convex deploy",
    "env:dev:check": "node --env-file-if-exists=.env.local --import tsx scripts/env-check.ts dev",
    "env:prod:check": "node --env-file-if-exists=.env.local --import tsx scripts/env-check.ts prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/attribution.test.ts tests/http.test.ts tests/seo.test.ts tests/auth.test.ts && vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests e2e convex playwright.config.ts next.config.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-organizer.ts",
    "event:config": "node --env-file-if-exists=.env.local --import tsx scripts/event-config.ts",
    "event:nov": "node --env-file-if-exists=.env.local --import tsx scripts/seed-nov-event.ts",
    "stripe:reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/reconcile.ts",
    "dev:dedupe-pending": "node --env-file-if-exists=.env.local --import tsx scripts/dedupe-pending-attendees.ts",
    "dev:email-schedule": "node --env-file-if-exists=.env.local --import tsx scripts/dev-email-schedule-test.ts",
    "dev:followup-test": "node --env-file-if-exists=.env.local --import tsx scripts/dev-followup-test.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired",
    "stripe:sync-env": "node --import tsx scripts/sync-stripe-cli-env.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@fontsource/anton": "^5.3.0",
    "better-auth": "~1.6.15",
    "convex": "^1.46.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.60",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
