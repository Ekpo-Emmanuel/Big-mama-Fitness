# Copy to .env.local for local development. Never commit real secrets.
# Local origin. Production Next.js uses APP_URL=https://www.bigmamafit.ca
# (apex https://bigmamafit.ca permanently redirects to www).
# Server-only. Do not use a NEXT_PUBLIC_ prefix. Metadata, checkout, and calendar links read this.
APP_URL=http://localhost:3000
# Set true only behind a proxy that replaces X-Forwarded-For.
TRUST_PROXY=false

# Convex (create with npx convex dev)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Optional admin key for calling internal functions from scripts.
CONVEX_DEPLOY_KEY=

# Better Auth. Also set BETTER_AUTH_SECRET and SITE_URL on the Convex deployment.
# Local Convex:
# npx convex env set BETTER_AUTH_SECRET <secret>
# npx convex env set SITE_URL http://localhost:3000
# Production Convex (public site, email links, and Better Auth origin):
# npx convex env set SITE_URL "https://www.bigmamafit.ca"
# SITE_URL is server-only. Do not use a NEXT_PUBLIC_ prefix.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Prefer a restricted Stripe API key with Checkout create/read permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not used by hosted Checkout; reserved for a future embedded integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared internal secret for Next.js server code and local scripts that call Convex.
# Not a cron secret. The email polling cron has been removed.
# Server-only. Never use a NEXT_PUBLIC_ prefix.
# Next.js and the Convex deployment must use the same value. Minimum length: 32 characters.
#   npx convex env set CRON_SECRET <same value as below>
# TODO: After the application is stable, stage a rename to INTERNAL_API_SECRET.
#       Keep CRON_SECRET working until Next.js and Convex both use the new name.
CRON_SECRET=

RESEND_API_KEY=
# Resend delivery webhooks (email.sent / delivered / delayed / bounced / complained / suppressed).
# Create endpoint pointing at /api/webhooks/resend and paste the signing secret here.
RESEND_WEBHOOK_SECRET=
# Transactional sender. Set the same values on Convex. Server-only. Never NEXT_PUBLIC_.
# Verify Resend domain bigmamafit.ca before production. Intended sender: info@bigmamafit.ca
# npx convex env set EMAIL_FROM "Big Mama Fitness <info@bigmamafit.ca>"
# npx convex env set EMAIL_REPLY_TO "info@bigmamafit.ca"
EMAIL_FROM="Big Mama Fitness <info@bigmamafit.ca>"
EMAIL_REPLY_TO="info@bigmamafit.ca"
# Optional extra organizer inbox. Active organizers also receive registration notices.
ORGANIZER_EMAIL=
# Optional. If set (non-empty), every Convex outbound email is redirected here.
# Original recipients are prefixed on the subject. Dev only. Leave empty for real recipients.
# Set on the Convex deployment; Next.js no longer sends mail.
EMAIL_TEST_REDIRECT=
# npx convex env set ALLOW_EMAIL_TEST_REDIRECT true
# Real recipients: npx convex env remove EMAIL_TEST_REDIRECT
# Production Convex: unset EMAIL_TEST_REDIRECT and ALLOW_EMAIL_TEST_REDIRECT, then:
# npx convex env set --prod EMAIL_PRODUCTION true
# See ENVIRONMENTS.md.

# Production EMAIL_FROM must be a verified Resend domain sender, not onboarding@resend.dev.
# Sending domain to verify in Resend: bigmamafit.ca
# Add the DNS records Resend shows (SPF and DKIM) at the domain host. This repo does not change DNS.

# If GTM is configured, do not also install a separate GA tag in the app.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_API_SECRET=
GOOGLE_SITE_VERIFICATION=
